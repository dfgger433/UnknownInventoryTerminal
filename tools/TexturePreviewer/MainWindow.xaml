<Window x:Class="UnknownInventoryTerminal.TexturePreviewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="终端贴图实时预览" Width="1440" Height="920" MinWidth="980" MinHeight="680"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="10" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="OpenButton" Content="选择资源目录…" Click="OpenFolder_Click" Margin="0,0,8,0" />
        <Button x:Name="RefreshButton" Content="重新载入" Click="Refresh_Click" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="终端贴图工作台" FontSize="23" FontWeight="SemiBold" />
        <TextBlock x:Name="FolderLabel" Text="选择包含 screens/ 和 textures/ 的 AE2 资源目录" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="190" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="400" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="280" MinWidth="240" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="屏幕区域" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="RegionCountLabel" Text="等待资源" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
          </StackPanel>
          <ListBox x:Name="RegionList" SelectionChanged="RegionList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#344541" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="220" MinHeight="160" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="终端拼装" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="AE2 源像素 · 实时重载" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Grid x:Name="CompositeHost" MinWidth="400" MinHeight="300" Background="#171B20">
                <Canvas x:Name="CompositeCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="贴图图集" FontSize="14" FontWeight="SemiBold" />
              <TextBlock x:Name="AtlasLabel" Text="" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0" />
            </StackPanel>
            <Viewbox x:Name="AtlasViewport" Stretch="Uniform" StretchDirection="DownOnly">
              <Grid x:Name="AtlasHost" Background="{StaticResource CheckerBrush}" ClipToBounds="True">
                <Image x:Name="AtlasImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="AtlasOverlay" IsHitTestVisible="False" />
              </Grid>
            </Viewbox>
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="区域检查器" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailName" Text="选择一个屏幕区域" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailTexture" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailRect" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
          </StackPanel>
          <Border Background="{StaticResource CheckerBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Height="200" VerticalAlignment="Top">
            <Viewbox Stretch="Uniform">
              <Image x:Name="CropImage" Stretch="None" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Viewbox>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="解析状态" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="StatusBox" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#171B20" Foreground="{StaticResource MutedBrush}" BorderBrush="{StaticResource LineBrush}" Padding="8" MinHeight="100" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
    <DockPanel Grid.Row="4">
      <TextBlock x:Name="LiveIndicator" Text="● 未连接" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="使用后端 Ae2ScreenStyle 校验屏幕 JSON 与裁切边界" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
    </DockPanel>
  </Grid>
</Window>
