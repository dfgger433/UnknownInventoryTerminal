<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</GameRoot>
    <Managed>$(GameRoot)\CasualtiesUnknown_Data\Managed</Managed>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UnknownInventoryTerminal.Core\UnknownInventoryTerminal.Core.csproj" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\unknowninventoryterminal\NOTICE.txt" Link="assets\unknowninventoryterminal\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\unknowninventoryterminal\licenses\modernity\LICENSE.txt" Link="assets\unknowninventoryterminal\licenses\modernity\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\unknowninventoryterminal\screens\**\*.json" Link="assets\unknowninventoryterminal\screens\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\unknowninventoryterminal\textures\**\*.png" Link="assets\unknowninventoryterminal\textures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Lang\*.json" Link="Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\Lang\en_us.json" LogicalName="UnknownInventoryTerminal.Lang.en_us.json" />
    <Reference Include="$(Managed)\UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Unity.TextMeshPro.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Assembly-CSharp.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)\BepInEx\core\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)\BepInEx\core\0Harmony.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)\BepInEx\plugins\CUCoreLib.dll"><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Managed)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="GeneratePluginVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginVersionSource>$(IntermediateOutputPath)PluginVersion.g.cs</PluginVersionSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginVersionSource)" Lines="namespace UnknownInventoryTerminal { internal static class BuildVersion { internal const string Value = &quot;$(Version)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(PluginVersionSource)" />
      <FileWrites Include="$(PluginVersionSource)" />
    </ItemGroup>
  </Target>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Managed)\Assembly-CSharp.dll')" Text="Game assembly missing. Set -p:GameRoot=your-game-directory." />
    <Error Condition="!Exists('$(GameRoot)\BepInEx\plugins\CUCoreLib.dll')" Text="Install CUCoreLib before building this plugin." />
  </Target>
</Project>
